#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3


/ {
	behaviors {
		/* Key positions (see cradio.dtsi transform):
		 *   0-4   Q W E R T      5-9   Y U I O P
		 *  10-14  A S D F G     15-19  H J K L ;
		 *  20-24  Z X C V B     25-29  N M , . /
		 *  30 RET  31 TAB       32 ESC  33 SPACE
		 *
		 * Left home-row mods: the hold only activates when the key that
		 * follows is on the right half, so same-hand rolls (e.g. "as",
		 * "fd") always type letters instead of firing a modifier.
		 * require-prior-idle-ms forces a tap when the key is pressed
		 * right after any other key, i.e. in the middle of typing.
		 */
		hml: homerow_mods_left {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			tapping-term-ms = <200>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			flavor = "balanced";
			hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
			bindings = <&kp>, <&kp>;
		};

		hmr: homerow_mods_right {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			tapping-term-ms = <200>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			flavor = "balanced";
			hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
			bindings = <&kp>, <&kp>;
		};
	};

	conditional_layers {
		compatible = "zmk,conditional-layers";
		func_layer {
			if-layers = <LOWER RAISE>;
			then-layer = <ADJUST>;
		};
	};

	combos {
		compatible = "zmk,combos";
			combo_quote {
				timeout-ms = <100>;
				key-positions = <12 17>;
				bindings = <&kp SQT>;
			};
			combo_plus {
				timeout-ms = <50>;
				key-positions = <2 3>;
				bindings = <&kp PLUS>;
			};
			combo_tmux {
				timeout-ms = <60>;
				key-positions = <16 33>;
				bindings = <&kp LC(B)>;
			};
			combo_bkspace {
				timeout-ms = <100>;
				key-positions = <6 7>;
				bindings = <&kp BSPC>;
			};
			combo_inc {
				timeout-ms = <50>;
				key-positions = <3 6>;
				bindings = <&kp LG(PLUS)>;
			};
			combo_dec {
				timeout-ms = <50>;
				key-positions = <4 5>;
				bindings = <&kp LG(MINUS)>;
			};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
				&kp Q        &kp W        &kp E          &kp R        &kp T     &kp Y &kp U          &kp I          &kp O         &kp P
				&hml LALT A  &hml LCTL S  &hml LSHIFT D  &hml LGUI F  &kp G     &kp H &hmr RGUI J   &hmr RSHIFT K  &hmr RCTRL L  &hmr RALT SEMICOLON
				&kp Z        &kp X        &kp C          &kp V        &kp B     &kp N &kp M          &kp COMMA      &kp DOT       &kp SLASH
				                                       &lt RAISE RET    &lt LOWER TAB     &lt LOWER ESC &lt RAISE SPACE
			>;
		};

		lower_layer {
			bindings = <
				&kp F8          &kp F7          &kp F6            &kp F5          &kp KP_MULTIPLY   &kp MINUS  &kp N4            &kp N5            &kp N6          &kp F17
				&hml LALT F4    &hml LCTL F3    &hml LSHIFT F2    &hml LGUI F1    &kp KP_DIVIDE     &kp KP_DOT &hmr RGUI N0     &hmr RSHIFT N1    &hmr RCTRL N2   &hmr RALT N3
				&kp F12         &kp F11         &kp F10           &kp F9          &kp MINUS         &kp PLUS   &kp N9            &kp N8            &kp N7          &trans
				                                               &trans            &trans            &trans     &trans
			>;
		};

		raise_layer {
			bindings = <
				&trans          &trans          &kp EQUAL         &kp F16         &trans     &trans   &kp F17           &kp BSPC          &trans          &trans
				&hml LALT GRAVE &hml LCTL BSLH &hml LSHIFT LBKT   &hml LGUI RBKT  &kp SQT    &kp LEFT &hmr RGUI DOWN   &hmr RSHIFT UP    &hmr RCTRL RIGHT &trans
				&trans          &kp UNDER       &kp LPAR          &kp RPAR        &kp MINUS  &kp C_PP &kp C_NEXT        &kp C_VOL_DN      &kp C_VOL_UP    &trans
				                                               &trans            &trans     &trans   &trans
			>;
		};

		adjust_layer {
			bindings = <
				&bootloader &none &none &bt BT_CLR &bt BT_SEL 0        &bt BT_SEL 3 &none &none &none &bootloader
				&none       &none &none &none          &bt BT_SEL 1    &bt BT_SEL 4 &none &none &none &none
				&none       &none &none &none          &bt BT_SEL 2    &bt BT_SEL 5 &none &none &none &none
				                                   &none &none        &none &none
			>;
		};

	};
};
